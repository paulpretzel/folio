{
  "name": "Folio — Book Reader",
  "short_name": "Folio",
  "description": "Read PDF, EPUB, Kindle and Word books offline, one page at a time. Keeps your place and sorts your books into albums.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6f3ee",
  "theme_color": "#f6f3ee",
  "categories": ["books", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "pdfs", "accept": [
        "application/pdf", ".pdf",
        "application/epub+zip", ".epub", ".kepub",
        "application/x-mobipocket-ebook", "application/vnd.amazon.ebook", ".mobi", ".azw", ".azw3", ".prc",
        "application/x-fictionbook+xml", ".fb2", ".fbz",
        "application/vnd.comicbook+zip", ".cbz",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document", ".docx",
        "text/plain", ".txt", "text/markdown", ".md", "text/html", ".html", ".htm",
        "application/octet-stream"
      ] }]
    }
  }
}
